rules_version = '2';

// BLRS — Firestore security rules (version 2: one document per barangay).
// Paste this into: Firebase console → Firestore Database → Rules → Publish.
// Publish these rules BEFORE uploading the new index.html.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Main document: accounts, agents, announcements, municipal notices.
    match /registry/main {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.barangays is list;
      // After the move to per-barangay documents (schema 2), nothing may put a farmer list back here:
      // only an outdated, un-refreshed app version would try, and it is refused.
      allow update: if signedIn()
                    && request.resource.data.barangays is list
                    && (resource.data.get('schema', 0) != 2 || !('farmers' in request.resource.data))
                    && (!('farmers' in request.resource.data) || !('farmers' in resource.data)
                        || request.resource.data.farmers.size() >= resource.data.farmers.size() - 50);
      allow delete: if false;

      // One document per barangay: its farmers, animals, sales, messages and notifications.
      match /shards/{shardId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.get('schema', 0) == 2
                      && request.resource.data.farmers is list
                      && request.resource.data.batches is list
                      && request.resource.data.salesHistory is list;
        // Blocks any single save that removes more than 50 farmer records from a barangay at once.
        allow update: if signedIn()
                      && request.resource.data.get('schema', 0) == 2
                      && request.resource.data.farmers is list
                      && request.resource.data.batches is list
                      && request.resource.data.salesHistory is list
                      && request.resource.data.farmers.size() >= resource.data.farmers.size() - 50;
        allow delete: if false;
      }
    }

    // Everything else in the database is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
